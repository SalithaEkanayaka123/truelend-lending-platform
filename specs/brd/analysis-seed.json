  "safeguards": [
    {
      "id": "SG-1",
      "kind": "forbidden_action",
      "text": "Real bureau or credit-score integration."
    },
    {
      "id": "SG-2",
      "kind": "forbidden_action",
      "text": "Real document OCR or extraction; document upload records metadata only and stores no file content."
    },
    {
      "id": "SG-3",
      "kind": "forbidden_action",
      "text": "Real disbursement rails (NEFT, RTGS, IMPS); the response is stubbed."
    },
    {
      "id": "SG-4",
      "kind": "forbidden_action",
      "text": "Real collections or recovery workflow."
    },
    {
      "id": "SG-5",
      "kind": "forbidden_action",
      "text": "Multi-currency and foreign exchange; all amounts are INR."
    },
    {
      "id": "SG-6",
      "kind": "forbidden_action",
      "text": "Production deployment, secret management, multi-region operation and distributed locking."
    },
    {
      "id": "SG-7",
      "kind": "forbidden_action",
      "text": "Late fees, penal interest, prepayment rebates, foreclosure quotes, and schedule regeneration or restructuring."
    },
    {
      "id": "SG-8",
      "kind": "forbidden_action",
      "text": "Co-applicants, editing an application after submission, and withdrawing an application."
    },
    {
      "id": "SG-9",
      "kind": "forbidden_action",
      "text": "Token refresh, password reset, and user administration."
    },
    {
      "id": "SG-10",
      "kind": "forbidden_action",
      "text": "A fourth product type, editing score weights through the policy editor, and rolling back an approved policy version."
    },
    {
      "id": "SG-11",
      "kind": "forbidden_action",
      "text": "Report export, time-series trends and notifications."
    },
    {
      "id": "SG-12",
      "kind": "forbidden_action",
      "text": "Any requirement that depends on the optional AI runtime; every FR must be met with that runtime off."
    }
  ]
