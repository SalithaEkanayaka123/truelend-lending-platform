{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://truelend.local/schemas/data-models.schema.json",
  "title": "TrueLend M1 data models",
  "description": "Domain entity shapes as they cross the Service/API boundary. Money fields are 2-decimal strings on the wire (D-F); DB storage detail (integer paise, SQLite column types) is documented in data-models.md and is not repeated here.",
  "definitions": {
    "Money": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "Decimal-as-string with exactly 2 decimal places. Never a JSON number."
    },
    "Role": {
      "type": "string",
      "enum": ["CUSTOMER", "UNDERWRITER", "POLICY_EDITOR", "ADMIN"]
    },
    "ProductType": {
      "type": "string",
      "enum": ["PERSONAL", "VEHICLE", "EDUCATION"]
    },
    "DocumentType": {
      "type": "string",
      "enum": ["ID_PROOF", "ADDRESS_PROOF", "SALARY_SLIP", "VEHICLE_QUOTATION", "ADMISSION_LETTER", "FEE_STRUCTURE"]
    },
    "ApplicationStatus": {
      "type": "string",
      "enum": ["DRAFT", "SUBMITTED", "MANUAL_REVIEW", "APPROVED", "REJECTED"]
    },
    "DocumentStatus": {
      "type": "string",
      "enum": ["MISSING", "UPLOADED", "VERIFIED", "REJECTED"]
    },
    "DecisionType": {
      "type": "string",
      "enum": ["AUTO_APPROVE", "AUTO_REJECT", "MANUAL_REVIEW"]
    },
    "ResolutionKind": {
      "type": "string",
      "enum": ["MANUAL_REVIEW", "OVERRIDE"]
    },
    "ResolutionOutcome": {
      "type": "string",
      "enum": ["APPROVED", "REJECTED"]
    },
    "PolicyStatus": {
      "type": "string",
      "enum": ["DRAFT", "APPROVED"]
    },
    "ReasonCode": {
      "type": "string",
      "enum": ["INCOME_BELOW_MIN", "AGE_OUT_OF_RANGE", "SCORE_BELOW_MIN", "SCORE_MEETS_AUTO_APPROVE", "SCORE_IN_REVIEW_BAND"]
    },
    "OverrideReasonCode": {
      "type": "string",
      "enum": ["COMPENSATING_FACTORS", "DATA_CORRECTION", "SENIOR_APPROVAL"]
    },
    "AuditAction": {
      "type": "string",
      "enum": [
        "POLICY_CREATED", "POLICY_APPROVED", "DOCUMENT_VERIFIED", "DOCUMENT_REJECTED",
        "REVIEW_APPROVED", "REVIEW_REJECTED", "DECISION_OVERRIDDEN", "DISBURSEMENT_RECORDED", "EOD_RUN"
      ]
    },
    "CreditFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_default", "missed_payment_12m", "thin_file"],
      "properties": {
        "prior_default": { "type": "boolean" },
        "missed_payment_12m": { "type": "boolean" },
        "thin_file": { "type": "boolean" }
      }
    },
    "User": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "email", "role", "display_name", "active"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "email": { "type": "string", "format": "email" },
        "role": { "$ref": "#/definitions/Role" },
        "display_name": { "type": "string", "minLength": 1 },
        "active": { "type": "boolean" }
      }
    },
    "AuditEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "occurred_at", "actor_user_id", "actor_role", "action", "entity_type", "entity_id", "correlation_id"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "actor_user_id": { "type": "integer", "minimum": 1 },
        "actor_role": { "$ref": "#/definitions/Role" },
        "action": { "$ref": "#/definitions/AuditAction" },
        "entity_type": { "type": "string", "minLength": 1 },
        "entity_id": { "type": "integer", "minimum": 1 },
        "correlation_id": { "type": "string", "pattern": "^[A-Za-z0-9-]{8,64}$" },
        "reason_code": { "type": ["string", "null"] },
        "comment": { "type": ["string", "null"], "maxLength": 500 },
        "before": { "type": ["object", "null"] },
        "after": { "type": ["object", "null"] }
      }
    },
    "ProductRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_type", "policy_version", "min_age", "max_age", "min_income",
        "min_tenure_months", "max_tenure_months", "min_amount", "max_amount",
        "annual_rate_pct", "required_documents"
      ],
      "properties": {
        "product_type": { "$ref": "#/definitions/ProductType" },
        "policy_version": { "type": "integer", "minimum": 1 },
        "min_age": { "type": "integer", "minimum": 0 },
        "max_age": { "type": "integer", "minimum": 0 },
        "min_income": { "$ref": "#/definitions/Money" },
        "min_tenure_months": { "type": "integer", "minimum": 1 },
        "max_tenure_months": { "type": "integer", "minimum": 1 },
        "min_amount": { "$ref": "#/definitions/Money" },
        "max_amount": { "$ref": "#/definitions/Money" },
        "annual_rate_pct": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
        "auto_reject_below_score": { "type": "integer", "minimum": 300, "maximum": 900 },
        "auto_approve_min_score": { "type": "integer", "minimum": 300, "maximum": 900 },
        "required_documents": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/DocumentType" }
        }
      }
    },
    "PolicyVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "status", "sha256", "created_by", "created_at"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "status": { "$ref": "#/definitions/PolicyStatus" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "base_version": { "type": ["integer", "null"], "minimum": 1 },
        "created_by": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "approved_by": { "type": ["integer", "null"] },
        "approved_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "PolicyFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "products", "reason_codes", "override_reason_codes"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "products": {
          "type": "object",
          "additionalProperties": false,
          "required": ["PERSONAL", "VEHICLE", "EDUCATION"],
          "properties": {
            "PERSONAL": { "$ref": "#/definitions/ProductRule" },
            "VEHICLE": { "$ref": "#/definitions/ProductRule" },
            "EDUCATION": { "$ref": "#/definitions/ProductRule" }
          }
        },
        "reason_codes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "override_reason_codes": {
          "type": "array",
          "items": { "$ref": "#/definitions/OverrideReasonCode" }
        }
      }
    },
    "DocumentChecklistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "status"],
      "properties": {
        "document_id": { "type": ["integer", "null"] },
        "type": { "$ref": "#/definitions/DocumentType" },
        "status": { "$ref": "#/definitions/DocumentStatus" },
        "filename": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "Application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "applicant_user_id", "product_type", "requested_amount", "tenure_months",
        "age_years", "monthly_income", "credit_flags", "pan_masked", "aadhaar_masked",
        "status", "required_documents", "created_at"
      ],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "applicant_user_id": { "type": "integer", "minimum": 1 },
        "product_type": { "$ref": "#/definitions/ProductType" },
        "requested_amount": { "$ref": "#/definitions/Money" },
        "tenure_months": { "type": "integer", "minimum": 1 },
        "age_years": { "type": "integer", "minimum": 0 },
        "monthly_income": { "$ref": "#/definitions/Money" },
        "credit_flags": { "$ref": "#/definitions/CreditFlags" },
        "pan_masked": { "type": "string", "pattern": "^\\*{6}[0-9]{3}[A-Z]$" },
        "aadhaar_masked": { "type": "string", "pattern": "^\\*{8}[0-9]{4}$" },
        "status": { "$ref": "#/definitions/ApplicationStatus" },
        "policy_version": { "type": ["integer", "null"] },
        "required_documents": {
          "type": "array",
          "items": { "$ref": "#/definitions/DocumentChecklistItem" }
        },
        "decision": {
          "oneOf": [{ "$ref": "#/definitions/Decision" }, { "type": "null" }]
        },
        "resolution": {
          "oneOf": [{ "$ref": "#/definitions/Resolution" }, { "type": "null" }]
        },
        "created_at": { "type": "string", "format": "date-time" },
        "submitted_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "Document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "application_id", "type", "status"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "application_id": { "type": "integer", "minimum": 1 },
        "type": { "$ref": "#/definitions/DocumentType" },
        "status": { "$ref": "#/definitions/DocumentStatus" },
        "filename": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
        "uploaded_at": { "type": ["string", "null"], "format": "date-time" },
        "verified_by": { "type": ["integer", "null"] },
        "verified_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "VerificationQueueItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "application_id", "type", "uploaded_at"],
      "properties": {
        "document_id": { "type": "integer", "minimum": 1 },
        "application_id": { "type": "integer", "minimum": 1 },
        "type": { "$ref": "#/definitions/DocumentType" },
        "uploaded_at": { "type": "string", "format": "date-time" }
      }
    },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "score", "reason_codes", "policy_version", "decided_at"],
      "properties": {
        "decision": { "$ref": "#/definitions/DecisionType" },
        "score": { "type": "integer", "minimum": 300, "maximum": 900 },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/ReasonCode" }
        },
        "policy_version": { "type": "integer", "minimum": 1 },
        "decided_at": { "type": "string", "format": "date-time" }
      }
    },
    "Resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "outcome", "comment", "resolved_by", "resolved_at"],
      "properties": {
        "kind": { "$ref": "#/definitions/ResolutionKind" },
        "outcome": { "$ref": "#/definitions/ResolutionOutcome" },
        "reason_code": {
          "oneOf": [{ "$ref": "#/definitions/OverrideReasonCode" }, { "type": "null" }]
        },
        "comment": { "type": "string", "minLength": 1, "maxLength": 500 },
        "resolved_by": { "type": "integer", "minimum": 1 },
        "resolved_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
